digraph "vga_colorbar" {
label="vga_colorbar";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="hsync", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="key_in", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="pix_data", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="pix_x", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="pix_y", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="rgb", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="state", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="vga_clk", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="vsync", color="black", fontcolor="black" ];
c12 [ shape=record, label="{{<p2> key_in|<p9> sys_rst_n|<p10> vga_clk}|key_ctrl_inst\nkey_ctrl|{<p7> state}}" ];
c13 [ shape=record, label="{{<p8> sys_clk|<p9> sys_rst_n}|pll_inst\npll|{<p10> vga_clk}}" ];
c14 [ shape=record, label="{{<p3> pix_data|<p9> sys_rst_n|<p10> vga_clk}|vga_ctrl_inst\nvga_ctrl|{<p1> hsync|<p4> pix_x|<p5> pix_y|<p6> rgb|<p11> vsync}}" ];
c15 [ shape=record, label="{{<p4> pix_x|<p5> pix_y|<p7> state|<p9> sys_rst_n|<p10> vga_clk}|vga_pic_inst\nvga_pic|{<p3> pix_data}}" ];
c14:p1:e -> n1:w [color="black", label=""];
c13:p10:e -> n10:w [color="black", label=""];
n10:e -> c12:p10:w [color="black", label=""];
n10:e -> c14:p10:w [color="black", label=""];
n10:e -> c15:p10:w [color="black", label=""];
c14:p11:e -> n11:w [color="black", label=""];
n2:e -> c12:p2:w [color="black", label=""];
c15:p3:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> c14:p3:w [color="black", style="setlinewidth(3)", label=""];
c14:p4:e -> n4:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> c15:p4:w [color="black", style="setlinewidth(3)", label=""];
c14:p5:e -> n5:w [color="black", style="setlinewidth(3)", label=""];
n5:e -> c15:p5:w [color="black", style="setlinewidth(3)", label=""];
c14:p6:e -> n6:w [color="black", style="setlinewidth(3)", label=""];
c12:p7:e -> n7:w [color="black", style="setlinewidth(3)", label=""];
n7:e -> c15:p7:w [color="black", style="setlinewidth(3)", label=""];
n8:e -> c13:p8:w [color="black", label=""];
n9:e -> c12:p9:w [color="black", label=""];
n9:e -> c13:p9:w [color="black", label=""];
n9:e -> c14:p9:w [color="black", label=""];
n9:e -> c15:p9:w [color="black", label=""];
}
