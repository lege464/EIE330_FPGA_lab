#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x645d52419900 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x645d52419a90 .scope module, "pll_tb" "pll_tb" 3 2;
 .timescale -9 -9;
v0x645d5242aa00_0 .var "sys_clk", 0 0;
v0x645d5242aad0_0 .var "sys_rst_n", 0 0;
v0x645d5242aba0_0 .net "vga_clk", 0 0, v0x645d5242a8e0_0;  1 drivers
S_0x645d523dfcf0 .scope module, "pll_inst" "pll" 3 21, 4 2 0, S_0x645d52419a90;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "vga_clk";
v0x645d523e1ba0_0 .net "sys_clk", 0 0, v0x645d5242aa00_0;  1 drivers
v0x645d5242a820_0 .net "sys_rst_n", 0 0, v0x645d5242aad0_0;  1 drivers
v0x645d5242a8e0_0 .var "vga_clk", 0 0;
E_0x645d523e0440/0 .event negedge, v0x645d5242a820_0;
E_0x645d523e0440/1 .event posedge, v0x645d523e1ba0_0;
E_0x645d523e0440 .event/or E_0x645d523e0440/0, E_0x645d523e0440/1;
    .scope S_0x645d523dfcf0;
T_0 ;
    %wait E_0x645d523e0440;
    %load/vec4 v0x645d5242a820_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x645d5242a8e0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x645d5242a8e0_0;
    %inv;
    %assign/vec4 v0x645d5242a8e0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x645d52419a90;
T_1 ;
    %vpi_call/w 3 9 "$dumpfile", "pll_tb.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x645d52419a90 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645d5242aa00_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x645d5242aad0_0, 0;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x645d5242aad0_0, 0;
    %delay 200, 0;
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x645d52419a90;
T_2 ;
    %delay 10, 0;
    %load/vec4 v0x645d5242aa00_0;
    %inv;
    %store/vec4 v0x645d5242aa00_0, 0, 1;
    %jmp T_2;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "Sim/pll_tb.v";
    "RTL/pll.v";
