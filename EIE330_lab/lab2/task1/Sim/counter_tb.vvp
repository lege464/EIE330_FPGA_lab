#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x559426f40e80 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x559426f41010 .scope module, "tb_counter" "tb_counter" 3 3;
 .timescale -9 -9;
v0x559426f53160_0 .net "led_out", 0 0, v0x559426f52ec0_0;  1 drivers
v0x559426f53230_0 .var "sys_clk", 0 0;
v0x559426f53300_0 .var "sys_rst_n", 0 0;
S_0x559426f05cf0 .scope module, "dut" "counter" 3 9, 4 3 0, S_0x559426f41010;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "led_out";
v0x559426f07ba0_0 .var "cnt", 24 0;
v0x559426f52ec0_0 .var "led_out", 0 0;
v0x559426f52f80_0 .net "sys_clk", 0 0, v0x559426f53230_0;  1 drivers
v0x559426f53020_0 .net "sys_rst_n", 0 0, v0x559426f53300_0;  1 drivers
E_0x559426f061b0/0 .event negedge, v0x559426f53020_0;
E_0x559426f061b0/1 .event posedge, v0x559426f52f80_0;
E_0x559426f061b0 .event/or E_0x559426f061b0/0, E_0x559426f061b0/1;
    .scope S_0x559426f05cf0;
T_0 ;
    %wait E_0x559426f061b0;
    %load/vec4 v0x559426f53020_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 25;
    %assign/vec4 v0x559426f07ba0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x559426f52ec0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x559426f07ba0_0;
    %cmpi/e 24, 0, 25;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 25;
    %assign/vec4 v0x559426f07ba0_0, 0;
    %load/vec4 v0x559426f52ec0_0;
    %inv;
    %assign/vec4 v0x559426f52ec0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x559426f07ba0_0;
    %addi 1, 0, 25;
    %assign/vec4 v0x559426f07ba0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x559426f41010;
T_1 ;
    %delay 10, 0;
    %load/vec4 v0x559426f53230_0;
    %inv;
    %store/vec4 v0x559426f53230_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x559426f41010;
T_2 ;
    %vpi_call/w 3 18 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call/w 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x559426f41010 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x559426f53230_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x559426f53300_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x559426f53300_0, 0, 1;
    %delay 3000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x559426f53300_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x559426f53300_0, 0, 1;
    %delay 3000, 0;
    %vpi_call/w 3 28 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "sim/tb_counter.v";
    "RTL/counter.v";
